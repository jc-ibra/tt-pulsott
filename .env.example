# Plantilla de credenciales de PULSOTT. Cópiala como .env y llena los valores.
# El .env real NUNCA se sube al repositorio.

# Base de datos MySQL (usuario propio del sistema, solo lee y escribe en esta base)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pulsott
DB_USER=pulsott_app
DB_PASSWORD=

# GLPI (solo lectura). URL sin /apirest.php
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_VERIFY_SSL=true
GLPI_TIMEOUT=30
